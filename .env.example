WHISPER_BIN=whisper
WHISPER_MODEL=turbo

TRANSLATION_PROVIDER=ollama
TRANSLATION_TIMEOUT_SECONDS=600
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b

# Optional OpenAI-compatible translation endpoint. Never commit real keys.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

COSYVOICE_ROOT=~/CosyVoice
COSYVOICE_MODEL=~/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B
COSYVOICE_URL=http://127.0.0.1:50001
COSYVOICE_HOST=127.0.0.1
COSYVOICE_PORT=50001
COSYVOICE_REQUEST_TIMEOUT=900
# Colon-separated roots allowed for reference audio; blank defaults to WORK_DIR.
COSYVOICE_ALLOWED_AUDIO_ROOTS=

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp
YTDLP_PROXY=
YTDLP_COOKIES=
# Current YouTube extraction needs yt-dlp-ejs plus an external JS runtime.
YTDLP_JS_RUNTIME=node
# Leave blank when yt-dlp-ejs is installed locally (the default setup).
YTDLP_REMOTE_COMPONENTS=
YTDLP_MAX_HEIGHT=1080

WORK_DIR=./work
ORIGINAL_AUDIO_VOLUME=0.14
MAX_UPLOAD_GB=20
HOST=127.0.0.1
PORT=8000

# ASS subtitle styling
SUBTITLE_FONT=PingFang SC
SUBTITLE_FONT_SIZE=54
